{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/stamps9k/milonga-studio/db/figure.schema.json",
  "title": "Milonga Studio figure",
  "description": "One figure file in db/figures/. This schema is for editors (autocomplete and as-you-type checks) and describes exactly what parseFigureDefinition in src/libs/dance/authoring.mts accepts; test/db/figureSchema.test.mts keeps the two in step. Whether the steps make sense as dancing is checked when the seed runs. See db/FIGURES.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "style", "time", "steps"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this schema, for editors: \"../figure.schema.json\"."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Shown in the library. Must be unique across the figure files."
    },
    "style": {
      "type": "string",
      "minLength": 1,
      "description": "Free-form tag that groups the library, such as \"tango\", \"waltz\" or \"cha-cha\"."
    },
    "time": {
      "type": "string",
      "pattern": "^\\d+/\\d+$",
      "description": "Time signature, such as \"3/4\" or \"4/4\"."
    },
    "start": {
      "enum": ["closed", "crossed promenade", "promenade apart"],
      "description": "Starting stance. Default \"closed\"."
    },
    "slow": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Beats in an S when steps use \"length\". Default 2; a Q is half."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "Free text for whoever edits the file. Not stored or shown in the app."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" },
      "description": "The steps, in time order."
    },
    "expectBeats": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "How many beats the figure should last, checked against the steps' timing."
    },
    "expectEnd": {
      "description": "Where the figure should finish, checked against the steps (within 1 mm).",
      "oneOf": [
        { "$ref": "#/definitions/expectStance" },
        { "$ref": "#/definitions/expectFeet" }
      ]
    }
  },
  "definitions": {
    "action": {
      "description": "A direction relative to the dancer's facing (or degrees clockwise from forward), an offset in metres ({ \"forward\": 0.9, \"right\": 0.2 }), \"close\", \"in place\" or \"pivot\".",
      "anyOf": [
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "forward": {
              "type": "number",
              "description": "Metres forward (negative for back), from the facing before the step's turn."
            },
            "right": {
              "type": "number",
              "description": "Metres to the right (negative for left), from the facing before the step's turn."
            }
          }
        },
        {
          "enum": [
            "forward",
            "diagonal forward right",
            "side right",
            "diagonal back right",
            "back",
            "diagonal back left",
            "side left",
            "diagonal forward left",
            "close",
            "in place",
            "pivot"
          ]
        }
      ]
    },
    "turnAmount": {
      "description": "A fraction of a full turn: a number such as 0.125, or text such as \"1/8\".",
      "anyOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "pattern": "^0*[1-9]\\d*\\s*/\\s*0*[1-9]\\d*$" }
      ]
    },
    "turn": {
      "description": "{ \"right\": \"1/8\" } turns clockwise (natural); { \"left\": \"3/8\" } turns anticlockwise (reverse).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "right": { "$ref": "#/definitions/turnAmount" },
        "left": { "$ref": "#/definitions/turnAmount" }
      }
    },
    "foot": {
      "enum": ["L", "R"],
      "description": "Usually left out: the free foot (or for a pivot, the standing foot) is used."
    },
    "by": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Distance travelled, in metres."
    },
    "rise": {
      "type": "number",
      "description": "Rise at the end of the step, in metres. Default 0."
    },
    "weight": {
      "type": "boolean",
      "description": "false for a step without weight (a tap): the foot moves, the weight stays."
    },
    "air": {
      "type": "boolean",
      "description": "true for an airborne action (boleo, gancho): out and back, no weight."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Text shown for the step."
    },
    "partner": {
      "description": "An action, or an object with the action in \"go\" and this partner's own options.",
      "anyOf": [
        { "$ref": "#/definitions/action" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["go"],
          "properties": {
            "go": { "$ref": "#/definitions/action" },
            "foot": { "$ref": "#/definitions/foot" },
            "by": { "$ref": "#/definitions/by" },
            "turn": { "$ref": "#/definitions/turn" },
            "rise": { "$ref": "#/definitions/rise" },
            "weight": { "$ref": "#/definitions/weight" },
            "air": { "$ref": "#/definitions/air" },
            "label": { "$ref": "#/definitions/label" }
          }
        }
      ]
    },
    "step": {
      "description": "One moment: \"both\" (the follow mirrors the lead), or \"lead\" and/or \"follow\". Timing is \"beat\" or \"length\", one style per figure.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "both": { "$ref": "#/definitions/action" },
        "lead": { "$ref": "#/definitions/partner" },
        "follow": { "$ref": "#/definitions/partner" },
        "beat": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "When the step starts, counting from 1 (3.5 for \"3&\")."
        },
        "length": {
          "enum": ["S", "Q"],
          "description": "A slow or a quick; steps follow one another."
        },
        "label": {
          "description": "One label for both partners, or one each.",
          "anyOf": [
            { "$ref": "#/definitions/label" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lead": { "$ref": "#/definitions/label" },
                "follow": { "$ref": "#/definitions/label" }
              }
            }
          ]
        },
        "foot": { "$ref": "#/definitions/foot" },
        "by": { "$ref": "#/definitions/by" },
        "turn": { "$ref": "#/definitions/turn" },
        "rise": { "$ref": "#/definitions/rise" },
        "weight": { "$ref": "#/definitions/weight" },
        "air": { "$ref": "#/definitions/air" }
      }
    },
    "point": {
      "description": "[x, y] in metres, in the figure's own frame (+y is forward, +x is the lead's right).",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "feetOf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L", "R"],
      "properties": {
        "L": { "$ref": "#/definitions/point" },
        "R": { "$ref": "#/definitions/point" }
      }
    },
    "expectStance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stance"],
      "properties": {
        "stance": {
          "enum": ["closed", "crossed promenade", "promenade apart"]
        },
        "moved": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward": { "type": "number" },
            "right": { "type": "number" }
          }
        },
        "turned": { "$ref": "#/definitions/turn" },
        "leadStandingOn": { "enum": ["L", "R"] }
      }
    },
    "expectFeet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feet"],
      "properties": {
        "feet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lead", "follow"],
          "properties": {
            "lead": { "$ref": "#/definitions/feetOf" },
            "follow": { "$ref": "#/definitions/feetOf" }
          }
        },
        "facing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lead": { "type": "number" },
            "follow": { "type": "number" }
          }
        }
      }
    }
  }
}
