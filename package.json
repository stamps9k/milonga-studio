{
  "name": "milonga-studio",
  "version": "0.0.1",
  "description": "A ballroom dance step planning app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamps9k/milonga-studio.git"
  },
  "keywords": [
    "node",
    "typescript",
    "dance"
  ],
  "author": "Stampatron",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/stamps9k/milonga-studio/issues"
  },
  "homepage": "https://milonga.stampatron.com",
	"type": "module",
	"scripts": {
		"test": "node --import tsx --test test/**/*.test.mts",
		"dev": "vite --config config/vite.config.ts",
		"build": "tsc --noEmit -p config/tsconfig.build.json && vite build --config config/vite.config.ts",
		"preview": "vite preview --config config/vite.config.ts",
		"lint": "eslint --config config/eslint.config.mjs .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@types/node": "^22.10.0",
		"@types/qrcode": "^1.5.6",
		"eslint-config-prettier": "^9.0.0",
		"husky": "^9.1.7",
		"prettier": "^3.8.3",
		"tsx": "^4.21.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^6.0.0"
	},
	"lint-staged": {
		"**/*.mts": [
			"eslint --fix --config config/eslint.config.mjs",
			"prettier --write --config config/.prettierrc"
		]
	},
	"dependencies": {
	}
}
